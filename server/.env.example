# Server Configuration
PORT=4000
NODE_ENV=production

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@[DIRECT_DB_HOST]:5432/postgres?sslmode=require

# AI Planner Configuration
AI_API_KEY=your_ai_api_key_here
AI_ENDPOINT=https://your-ai-endpoint.example.com
AI_MODEL=your_model_name
AI_REASONING_EFFORT=medium
# Optional local-only cache; leave unset on Vercel because function files are ephemeral.
AI_CACHE_FILE=./data/ai-plan-cache.json

# Google Calendar Integration (Optional for meeting scheduling)
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIME_ZONE=UTC
MEETING_ALLOWED_ATTENDEES=alex.rivera@nexusflow.io,elena.rostova@nexusflow.io,marcus.vance@nexusflow.io
MEETING_REMINDER_MINUTES=15

# Cross-Origin Auth (Only if frontend and backend are hosted on different domains)
CLIENT_ORIGIN=https://your-frontend-domain.com
CROSS_ORIGIN_AUTH=false
